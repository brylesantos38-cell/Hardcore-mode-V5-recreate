-- Entity Despawn Callback
entity:SetCallback("OnDespawning", function()
    camShake:Start()
    camShake:ShakeOnce(10, 15, 0, 5.5, 1, 0)
    camShake:Shake(CameraShaker.Presets.Earthquake)

    -- Open next door on despawn
    local currentRoom = workspace.CurrentRooms[game.ReplicatedStorage.GameData.LatestRoom.Value]
    if currentRoom and currentRoom:FindFirstChild("Door") then
        currentRoom.Door.ClientOpen:FireServer()
    end

    local ripperModel = workspace:FindFirstChild("RipperMovings")
    if ripperModel then
        for _, v in pairs(ripperModel:GetDescendants()) do
            if v:IsA("Sound") then v:Destroy() end
        end
    end

    TweenService:Create(colorEffect, TweenInfo.new(10), {
        TintColor = Color3.fromRGB(255, 255, 255),
        Saturation = 0,
        Contrast = 0
    }):Play()
    Debris:AddItem(colorEffect, 10)

    if get then
        local function GitAud(soundgit, filename)
            if not isfile(filename..".mp3") then
                writefile(filename..".mp3", game:HttpGet(soundgit))
            end
            return (getcustomasset or getsynasset)(filename..".mp3")
        end

        local function CustomGitSound(soundlink, vol, filename)
            local sound = Instance.new("Sound")
            sound.SoundId = GitAud(soundlink, filename)
            sound.Parent = workspace
            sound.Volume = vol
            sound.Name = "DoorBreaker"
            sound:Play()
        end

        CustomGitSound("https://github.com/Darker-TheDarkestGuy/DOORS/raw/refs/heads/main/.mp3?raw=true", 1, "DoorBreaker")

        camShake:Start()
        camShake:ShakeOnce(20, 5, 5, 3, 2, 1)

        local CustomAchievements = loadstring(game:HttpGet("https://raw.githubusercontent.com/RegularVynixu/DOORS-Custom-Achievements/main/init.luau"))()

        CustomAchievements:Grant({
            Identifier = "Achievement",
            Title = "Torn Apart...",
            Desc = "Don't Leave Too Early",
            Reason = "Encounter ripper",
            Image = "rbxassetid://12231244908"
        }, {
            CheckOwned = true,
            Remember = true
        })
    end
end)

-- Reset Debounce
_G.RipperJumpscaring = false

-- Entity Damage Callback + Dynamic Distance Jumpscare Model Sequence
entity:SetCallback("OnDamagePlayer", function(newHealth)
    if _G.RipperJumpscaring then return end
    _G.RipperJumpscaring = true

    task.spawn(function()
        local Players = game:GetService("Players")
        local Workspace = game:GetService("Workspace")
        local RunService = game:GetService("RunService")

        local player = Players.LocalPlayer
        local character = player.Character or player.CharacterAdded:Wait()
        local humanoid = character:WaitForChild("Humanoid", 5)
        local humanoidRootPart = character:WaitForChild("HumanoidRootPart", 5)

        -- Freeze player movement
        if humanoidRootPart then
            humanoidRootPart.Anchored = true
        end
        if humanoid then
            humanoid.WalkSpeed = 0
            humanoid.JumpPower = 0
            humanoid.AutoRotate = false
        end

        -- Capture original Ripper position and distance to preserve proximity scaling
        local originalEntity = Workspace:FindFirstChild("RipperMovings")
        local targetCFrame = humanoidRootPart.CFrame * CFrame.new(0, 0, -15) -- default distance fallback

        if originalEntity and originalEntity.PrimaryPart then
            targetCFrame = originalEntity.PrimaryPart.CFrame
            originalEntity:Destroy()
        elseif originalEntity and originalEntity:FindFirstChildWhichIsA("BasePart") then
            targetCFrame = originalEntity:FindFirstChildWhichIsA("BasePart").CFrame
            originalEntity:Destroy()
        end

        -- Spawn the specific Jumpscare Model (rbxassetid://12788499750)
        local success, jumpscareModel = pcall(function()
            return game:GetObjects("rbxassetid://12788499750")[1]
        end)

        if not success or not jumpscareModel then
            warn("[Jumpscare] Failed to load jumpscare model asset!")
            if humanoid then humanoid.Health = 0 end
            return
        end

        jumpscareModel.Parent = Workspace
        
        -- Find primary part or any base part of the jumpscare model to position it properly
        local jsPrimary = jumpscareModel.PrimaryPart or jumpscareModel:FindFirstChildWhichIsA("BasePart")
        if jsPrimary then
            jumpscareModel:PivotTo(targetCFrame)
            jsPrimary.Anchored = true
        end

        -- Lock Camera to look at the jumpscare model matching its distance
        camera.CameraType = Enum.CameraType.Scriptable
        local camConnection = RunService.RenderStepped:Connect(function()
            if jsPrimary and jsPrimary.Parent then
                camera.CFrame = CFrame.lookAt(camera.CFrame.Position, jsPrimary.Position)
            end
        end)

        -- PHASE 1: Looming silence for 1.9 seconds (Model is visible at its respective distance)
        task.wait(1.9)

        -- PHASE 2: Trigger normal volume sound and TV static overlay system
        local crashSound = Instance.new("Sound")
        crashSound.SoundId = jumpscareSoundId
        crashSound.Volume = 3 -- Normal non-blinding volume as requested
        crashSound.Parent = Workspace
        crashSound:Play()

        -- UI Jumpscare Static Overlay
        local screenGui = Instance.new("ScreenGui")
        screenGui.Name = "JumpscareOverlay"
        screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        screenGui.IgnoreGuiInset = true
        screenGui.DisplayOrder = 999999
        screenGui.Parent = player:WaitForChild("PlayerGui")

        local imageLabel = Instance.new("ImageLabel")
        imageLabel.BackgroundTransparency = 1
        imageLabel.Size = UDim2.new(1, 0, 1, 0)
        imageLabel.ScaleType = Enum.ScaleType.Stretch
        imageLabel.Parent = screenGui

        local staticImage1 = "rbxassetid://11314955407" 
        local staticImage2 = "rbxassetid://236542974"

        -- Make the jumpscare long lasting
        local flashDuration = 2.5
        local flashStartTime = tick()

        task.spawn(function()
            while tick() - flashStartTime < flashDuration do
                imageLabel.Image = staticImage1
                imageLabel.ImageTransparency = math.random(0, 2) / 10
                task.wait(0.04)
                
                if tick() - flashStartTime >= flashDuration then break end
                
                imageLabel.Image = staticImage2
                imageLabel.ImageTransparency = 0
                task.wait(0.04)
            end
            screenGui:Destroy()
        end)

        task.wait(flashDuration)

        -- PHASE 3: Clean up, kill player, despawn entity & open the next room door
        if camConnection then camConnection:Disconnect() end
        camera.CameraType = Enum.CameraType.Custom

        if jumpscareModel and jumpscareModel.Parent then
            jumpscareModel:Destroy()
        end

        -- Open next door automatically upon player death sequence completion
        local currentRoom = workspace.CurrentRooms[game.ReplicatedStorage.GameData.LatestRoom.Value]
        if currentRoom and currentRoom:FindFirstChild("Door") then
            currentRoom.Door.ClientOpen:FireServer()
        end

        if humanoid then 
            humanoid.Health = 0 
        end
        
        _G.RipperJumpscaring = false
    end)
end)

