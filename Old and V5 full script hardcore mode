        local function startSprint()
            if cooldown or not Hum or Hum.Health <= 0 or ModuleScripts.MainGame.crouching or isSprinting or stamina <= 0 then
                return
            end

            isSprinting = true
            Hum:SetAttribute("SpeedBoost", 0)
            Hum.WalkSpeed = SPRINT_SPEED
            zerostamtween:Play()

            while holdingSprint and stamina > 0 and Hum and Hum.Health > 0 do
