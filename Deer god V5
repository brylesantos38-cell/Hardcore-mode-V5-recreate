-- Hàm dọn dẹp bộ nhớ khi ngưng thực thể
local function cleanup()
	death = false
	shuold = false
	if connection then connection:Disconnect() end
	if s then s:Destroy() end
	if Lord then Lord:Destroy() end
end

-- Vòng lặp tấn công
task.spawn(function()
	while death and task.wait(0.1) do
		if entity and entity.Parent and Character and Character.Parent then
			local currentHrp = Character:FindFirstChild("HumanoidRootPart")
			local hum = Character:FindFirstChildOfClass("Humanoid")

			if currentHrp and hum and hum.Health > 0 then
				local distance = (currentHrp.Position - entity.Position).Magnitude

				-- Kiểm tra khoảng cách va chạm (6 stud)
				if distance <= 6 then
