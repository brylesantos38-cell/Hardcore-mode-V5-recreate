						if not attacking then
							attacking = true
							hum:TakeDamage(0)

							PlayJumpscare1()

							if hum.Health <= 0 then
								local stats = ReplicatedStorage:FindFirstChild("GameStats")
								if stats then
									local playerStats = stats:FindFirstChild("Player_" .. player.Name)
									if playerStats and playerStats:FindFirstChild("Total") and playerStats.Total:FindFirstChild("DeathCause") then
										playerStats.Total.DeathCause.Value = "Deer Lord"
									end
								end
							end

							cleanup()
							task.wait(2)
