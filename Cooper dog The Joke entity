---====== Sound Setup ======---

local startSound = Instance.new("Sound")
startSound.SoundId = "rbxassetid://9125712561"
startSound.Volume = 3

local mainSound = Instance.new("Sound")
mainSound.SoundId = "rbxassetid://5041900663"
mainSound.Looped = true
mainSound.Volume = 3

---====== Entity Callbacks ======---

entity:SetCallback("OnSpawned", function()
	print("Entity has spawned")

	-- Play start sound
	startSound.Parent = workspace
	startSound:Play()

	-- Play looped main sound
	mainSound.Parent = workspace
	mainSound:Play()

	-- Add Green Glow / Color Effect to Cooper's Model
	local entityModel = workspace:FindFirstChild("Cooper dog") or (entity.Debug and entity.Debug.Model)
	if entityModel then
		local highlight = Instance.new("Highlight")
		highlight.FillColor = Color3.fromRGB(0, 255, 0)
		highlight.OutlineColor = Color3.fromRGB(0, 255, 0)
		highlight.FillTransparency = 0.5
		highlight.Parent = entityModel

		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(0, 255, 0)
		light.Range = 30
		light.Brightness = 5
		light.Parent = entityModel:FindFirstChildWhichIsA("BasePart") or entityModel
	end
end)

entity:SetCallback("OnStartMoving", function()
	print("Entity has started moving")
end)

entity:SetCallback("OnEnterRoom", function(room: Model, firstTime: boolean)
	if firstTime == true then
		print("Entity has entered room: ".. room.Name.. " for the first time")
	else
		print("Entity has entered room: ".. room.Name.. " again")
	end
end)

entity:SetCallback("OnLookAt", function(lineOfSight: boolean)
	if lineOfSight == true then
		print("Player is looking at entity")
	else
		print("Player view is obstructed by something")
	end
end)

entity:SetCallback("OnRebounding", function(startOfRebound: boolean)
	if startOfRebound == true then
		print("Entity has started rebounding")
	else
		print("Entity has finished rebounding")
	end
end)

entity:SetCallback("OnDespawning", function()
	print("Entity is despawning")
end)

entity:SetCallback("OnDespawned", function()
	print("Entity has despawned")

	-- Stop main moving sound
	mainSound:Stop()

	-- Play Despawn Sound
	local despawnSound = Instance.new("Sound", workspace)
	despawnSound.SoundId = "rbxassetid://1837765695"
	despawnSound.Volume = 5
	despawnSound:Play()

	local dis = Instance.new("DistortionSoundEffect")
	dis.Level = 0.75
	dis.Parent = despawnSound

	-- Red Screen Flash Effect
	local lighting = game.Lighting
	if lighting:FindFirstChild("MainColorCorrection") then
		lighting.MainColorCorrection.TintColor = Color3.fromRGB(255, 0, 0)
		lighting.MainColorCorrection.Contrast = 0.5
		TweenService:Create(lighting.MainColorCorrection, TweenInfo.new(2.5), {Contrast = 0}):Play()
		TweenService:Create(lighting.MainColorCorrection, TweenInfo.new(3), {TintColor = Color3.fromRGB(255, 255, 255)}):Play()
	end

	-- Camera Shake Effect
	local CameraShaker = require(game.ReplicatedStorage.CameraShaker)
	local camera = game.Workspace.CurrentCamera
	local camShake = CameraShaker.new(Enum.RenderPriority.Camera.Value, function(shakeCf)
		camera.CFrame = camera.CFrame * shakeCf
	end)
	camShake:Start()
	camShake:ShakeOnce(40, 70, 0, 4)

	-- Display Custom Caption
	local localPlayer = Players.LocalPlayer
	if localPlayer and localPlayer:FindFirstChild("PlayerGui") then
		local mainUI = localPlayer.PlayerGui:FindFirstChild("MainUI")
		if mainUI and mainUI:FindFirstChild("Initiator") and mainUI.Initiator:FindFirstChild("MainGame") then
			local MainGame = require(mainUI.Initiator.MainGame)
			MainGame.caption("Cooper: I'm not just a dog..", true)
		end
	end
end)

entity:SetCallback("OnDamagePlayer", function(newHealth: number)
	if newHealth <= 0 then
		print("Entity has killed the player - Initiating double jumpscare")

		local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
		
		-- Setup full-screen UI
		local jumpGui = Instance.new("ScreenGui")
		jumpGui.Name = "CooperJumpscare"
		jumpGui.IgnoreGuiInset = true
		jumpGui.Parent = playerGui

		local jumpImage = Instance.new("ImageLabel")
		jumpImage.Size = UDim2.new(1, 0, 1, 0)
		jumpImage.BackgroundColor3 = Color3.new(0, 0, 0)
		jumpImage.BackgroundTransparency = 0
		jumpImage.ScaleType = Enum.ScaleType.Fit
		jumpImage.Image = "rbxassetid://13793795091" -- Jumpscare UI 1
		jumpImage.Parent = jumpGui

		-- Camera Shaker setup for jumpscare intensity
		local CameraShaker = require(game.ReplicatedStorage.CameraShaker)
		local camera = game.Workspace.CurrentCamera
		local camShake = CameraShaker.new(Enum.RenderPriority.Camera.Value, function(shakeCf)
			camera.CFrame = camera.CFrame * shakeCf
		end)
		camShake:Start()

		-- Play Jumpscare Sound 1
		local jumpSound1 = Instance.new("Sound")
		jumpSound1.SoundId = "rbxassetid://77669369747680" 
		jumpSound1.Volume = 3
		jumpSound1.Parent = workspace
		jumpSound1:Play()
		camShake:ShakeOnce(20, 50, 0, 2.5) -- Extended shake duration for phase 1

		-- Wait before switching to the second phase (Increased to 2.5 seconds for a longer scare)
		task.wait(2.5)

		-- Switch to Jumpscare UI 2
		jumpImage.Image = "rbxassetid://131380212068463"
		
		-- Play Jumpscare Sound 2
		local jumpSound2 = Instance.new("Sound")
		jumpSound2.SoundId = "rbxassetid://106180173195358"
		jumpSound2.Volume = 3
		jumpSound2.Parent = workspace
		jumpSound2:Play()
		camShake:ShakeOnce(30, 60, 0, 4) -- Extended shake duration for phase 2

		-- Clean up the jumpscare screen after 4 seconds (Increased for a longer second phase)
		task.delay(4, function()
			if jumpGui then jumpGui:Destroy() end
			if jumpSound1 then jumpSound1:Destroy() end
			if jumpSound2 then jumpSound2:Destroy() end
			camShake:Stop()
		end)
	else
		print("Entity has damaged the player")
	end
end)

---====== Run entity ======---

entity:Run(true)
